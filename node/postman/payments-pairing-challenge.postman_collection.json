    {
      "name": "merchant-analytics (3002)",
      "description": "Merchant transactions and daily totals. Uses merchant id merch-{{runId}} so totals only include the transactions created here. \"Seeded merchant\" request reads merch-1 created by seed.sh.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{analyticsUrl}}/health",
              "host": [
                "{{analyticsUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",

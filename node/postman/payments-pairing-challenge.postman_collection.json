                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fromAccountId\": \"{{bobId}}\",\n  \"toAccountId\": \"{{aliceId}}\",\n  \"amount\": 1000000\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {

                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "api",
                    "transfer"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fromAccountId\": \"{{bobId}}\",\n  \"toAccountId\": \"{{bobId}}\",\n  \"amount\": 5\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Bob has 65. First write sets 60, second write uses stale to.balance + amount = 70."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [

                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/api/transfer",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "api",
                    "transfer"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fromAccountId\": \"{{aliceId}}\",\n  \"toAccountId\": \"{{bobId}}\",\n  \"amount\": 5\n}",
                  "options": {
                    "raw": {

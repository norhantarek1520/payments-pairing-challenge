{
  "info": {
    "name": "Payments Pairing Challenge (Node)",
    "description": "payments-api (3001) and merchant-analytics (3002). Start with `docker compose up --build` in node/. Run the whole collection with the Collection Runner, or folder by folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date();",
          "pm.collectionVariables.set('today', d.toISOString().slice(0, 10));",
          "pm.collectionVariables.set('yesterday', new Date(d.getTime() - 86400000).toISOString().slice(0, 10));",
          "if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', Date.now().toString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "paymentsUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "analyticsUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "aliceId",
      "value": ""
    },
    {
      "key": "bobId",
      "value": ""
    },
    {
      "key": "merchantAccountId",
      "value": ""
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "yesterday",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "payments-api (3001)",
      "description": "Accounts, debits, payments and transfers. Run the folders in order: each flow builds on the accounts created in \"1. Accounts\".\n\nAccount ids are suffixed with {{runId}} so the collection can be re-run without duplicate-key errors. \"Create account - Alice\" generates a new runId.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{paymentsUrl}}/health",
              "host": [
                "{{paymentsUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Accounts",
          "item": [
            {
              "name": "Create account - Alice (100)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id\": \"acc-alice-{{runId}}\",\n  \"ownerName\": \"Alice\",\n  \"balance\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.collectionVariables.set('runId', Date.now().toString());"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 201', () => pm.response.to.have.status(201));",
                      "const a = pm.response.json();",
                      "pm.test('balance is 100', () => pm.expect(a.balance).to.eql(100));",
                      "pm.collectionVariables.set('aliceId', a._id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Create account - Bob (50)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id\": \"acc-bob-{{runId}}\",\n  \"ownerName\": \"Bob\",\n  \"balance\": 50\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 201', () => pm.response.to.have.status(201));",
                      "pm.collectionVariables.set('bobId', pm.response.json()._id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Create account - Merchant (0)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id\": \"acc-merchant-{{runId}}\",\n  \"ownerName\": \"Merchant\",\n  \"balance\": 0,\n  \"merchantId\": \"merch-{{runId}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 201', () => pm.response.to.have.status(201));",
                      "pm.collectionVariables.set('merchantAccountId', pm.response.json()._id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get account - Alice",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts/{{aliceId}}",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "{{aliceId}}"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('owner is Alice', () => pm.expect(pm.response.json().ownerName).to.eql('Alice'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get account - unknown (404)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts/does-not-exist",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "does-not-exist"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 404', () => pm.response.to.have.status(404));",
                      "pm.test('error message', () => pm.expect(pm.response.json().error).to.eql('Account not found'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Create account - duplicate id (500, known issue #11)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id\": \"{{aliceId}}\",\n  \"ownerName\": \"Alice again\",\n  \"balance\": 1\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Duplicate _id raises Mongo E11000, which the error middleware maps to 500. Should be 409."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 500', () => pm.response.to.have.status(500));"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "2. Debit",
          "item": [
            {
              "name": "Debit Alice 10 (100 -> 90)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts/{{aliceId}}/debit",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "{{aliceId}}",
                    "debit"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 10\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('new balance is 90', () => pm.expect(pm.response.json().balance).to.eql(90));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get Alice after debit",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts/{{aliceId}}",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "{{aliceId}}"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('balance is 90', () => pm.expect(pm.response.json().balance).to.eql(90));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Debit - insufficient funds (500, known issue #2)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts/{{aliceId}}/debit",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "{{aliceId}}",
                    "debit"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 1000000\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Handler maps INSUFFICIENT_FUNDS to 500. Should be a 4xx."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 500', () => pm.response.to.have.status(500));",
                      "pm.test('error message', () => pm.expect(pm.response.json().error).to.eql('Insufficient funds'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Debit - unknown account (404)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts/does-not-exist/debit",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "does-not-exist",
                    "debit"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 1\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 404', () => pm.response.to.have.status(404));"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "3. Payments",
          "item": [
            {
              "name": "Create payment",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/payments",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "payments"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"accountId\": \"{{aliceId}}\",\n  \"merchantId\": \"merch-{{runId}}\",\n  \"amount\": 20,\n  \"currency\": \"USD\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Body is stored as-is plus status \"charged\" and createdAt. Publishes PAYMENT_CREATED to payment-events. Does not debit any account."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 201', () => pm.response.to.have.status(201));",
                      "const p = pm.response.json();",
                      "pm.test('status is charged', () => pm.expect(p.status).to.eql('charged'));",
                      "pm.test('has createdAt', () => pm.expect(p.createdAt).to.be.a('string'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get Alice after payment (balance unchanged, known issue #9)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts/{{aliceId}}",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "{{aliceId}}"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('balance still 90', () => pm.expect(pm.response.json().balance).to.eql(90));"
                    ]
                  }
                }
              ]
            }
          ]
        },

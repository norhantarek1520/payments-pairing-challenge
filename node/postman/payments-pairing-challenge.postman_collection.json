        {
          "name": "5. Edge cases (known bugs)",
          "description": "These document current buggy behaviour from CLAUDE.md \"Known issues\". Expected values describe what the code does today, not what it should do.",
          "item": [
            {
              "name": "Debit negative amount credits the account (#3)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentsUrl}}/accounts/{{bobId}}/debit",
                  "host": [
                    "{{paymentsUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "{{bobId}}",
                    "debit"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": -10\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('balance went UP (bug)', () => pm.expect(pm.response.json().balance).to.eql(65));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Transfer Bob -> Bob 5 creates money (#5)",
